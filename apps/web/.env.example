# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Application
# Public origin where the Next.js app is running (no trailing slash).
# Development example: https://your-device.your-tailnet.ts.net
# Production: https://hakgyo.id
APP_URL="http://localhost:3000"

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""

# Scheduled jobs
# Bearer token required by /api/cron/* routes. The GitHub Actions workflow
# .github/workflows/mobile-sync-compact.yml sends it (GitHub secret CRON_SECRET).
# Generate with: openssl rand -hex 32
CRON_SECRET=""

# ChatGPT plugin domain verification
# Token shown in the OpenAI Platform plugin dashboard. Served as plain text at
# /.well-known/openai-apps-challenge; leave empty when not submitting.
OPENAI_APPS_CHALLENGE_TOKEN=""

# Better Auth Google OAuth (Web application credentials)
# Callback URLs:
# http://localhost:3000/api/auth/callback/google
# https://your-domain.com/api/auth/callback/google
# Also register ${APP_URL}/api/integrations/google-meet/callback for the
# organizer's Google Calendar authorization. Enable Google Calendar API and
# request the calendar.events scope on the OAuth consent screen.
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Sign in with Apple (iOS app). Sign-in only needs the bundle ID, but App Store
# rules require revoking Apple tokens on account deletion, which needs a
# "Sign in with Apple" key from Apple Developer > Keys. Paste the .p8 contents
# with newlines escaped as \n.
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Maintenance mode (see docs/maintenance.md). Change on Vercel and redeploy.
# off (default) | scheduled (banner only) | read_only (writes rejected) |
# full (everything rejected except /auth and /superadmin pages).
# Superadmins bypass read_only and full in the web app and tRPC API.
MAINTENANCE_MODE="off"
# Optional Indonesian text replacing the default description. Leave the times
# out: they are appended from the variables below, in WIB.
MAINTENANCE_MESSAGE=""
# Optional ISO datetimes with an offset, e.g. 2026-10-20T22:00:00+07:00.
# STARTS_AT is announced while scheduled; UNTIL is the estimated end, sent as
# Retry-After and used by the mobile app to pause syncing until then.
MAINTENANCE_STARTS_AT=""
MAINTENANCE_UNTIL=""

# Comma-separated, lowercase email addresses allowed to access /superadmin.
SUPERADMIN_EMAILS="rorezxez@gmail.com"

# OpenAI (server only)
# Used to generate organization themes from uploaded logos.
OPENAI_API_KEY=""

# Resend (server only)
# Sends account emails: email verification and password reset. Verify your
# sending domain in the Resend dashboard (Domains), then create an API key.
# EMAIL_FROM must use that domain, e.g. Hakgyo <noreply@your-domain.com>.
# Required in production. Leave empty in development to print the email links
# in the server log.
RESEND_API_KEY=""
EMAIL_FROM=""

# ElevenLabs (server only)
# Used for text-to-speech.
ELEVENLABS_API_KEY=""

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env

# Pooled connection — buat aplikasi (pake -pooler di hostname)
DATABASE_URL="postgresql://user:***@ep-xxx-pooler.us-east-2.aws.neon.tech/hakgyo?sslmode=require&connect_timeout=15"

# Direct connection — buat Prisma CLI (tanpa -pooler)
DIRECT_URL="postgresql://user:***@ep-xxx.us-east-2.aws.neon.tech/hakgyo?sslmode=require"

# Optional: max pooled connections per server instance (default 10).
# DATABASE_POOL_MAX="10"

# Cloudflare R2 (server only)
# Bucket CORS must allow PUT requests from APP_URL with the Content-Type header.
CLOUDFLARE_R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="hakgyo"
CLOUDFLARE_R2_PUBLIC_URL="https://pub-3fd0ad0a99684361b69ca3270ed168c8.r2.dev"

# Zoom General App OAuth (server only)
# Register ${APP_URL}/api/integrations/zoom/callback as the OAuth redirect URL.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# Generate with: openssl rand -base64 32
# This integration token key encrypts both Zoom and Google Calendar grants.
ZOOM_TOKEN_ENCRYPTION_KEY=""

# WhatsApp groups for cohorts (docs/whatsapp.md). Hakgyo's Evolution API server (v2.4+, activated
# once through its /manager page). Leave empty to hide the WhatsApp integration.
EVOLUTION_API_URL=""
# The server's global AUTHENTICATION_API_KEY, used to create and delete instances.
EVOLUTION_API_KEY=""
# Sent by Evolution API as the x-hakgyo-webhook-secret header on every webhook. Generate with:
# openssl rand -base64 32
WHATSAPP_WEBHOOK_SECRET=""
# Encrypts per-organization instance tokens. Generate with: openssl rand -base64 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=""

# Web Push (VAPID) — generate with: bunx web-push generate-vapid-keys
# Public key is exposed to browsers for push subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Private key stays server-only and signs outgoing push messages. Never rotate casually:
# rotation invalidates every existing subscription and forces re-subscribe on all devices.
VAPID_PRIVATE_KEY=""
# Contact email used in VAPID JWT (mailto:). Required by some push services.
VAPID_CONTACT_EMAIL=""

# Expo push access token (expo.dev > Account settings > Access tokens).
# Required only when "enhanced push security" is enabled for the EAS project.
EXPO_ACCESS_TOKEN=""
