// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "postgresql"
}

model User {
  id                      String               @id
  name                    String //@db.Text
  email                   String
  emailVerified           Boolean              @default(false)
  image                   String? //@db.Text
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt
  sessions                Session[]
  accounts                Account[]
  organizationMemberships OrganizationMember[]
  acceptedOrganizationInvites OrganizationInvite[] @relation("OrganizationInviteAcceptedBy")
  courseEnrollments       CourseEnrollment[]
  cohortEnrollments       CohortEnrollment[]
  contentProgress         ContentProgress[]
  assessmentAttempts      AssessmentAttempt[]
  uploadedAssets          Asset[]
  oauthClients            OauthClient[]
  oauthRefreshTokens      OauthRefreshToken[]
  oauthAccessTokens       OauthAccessToken[]
  oauthConsents           OauthConsent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                 String              @id
  expiresAt          DateTime
  token              String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  ipAddress          String? //@db.Text
  userAgent          String? //@db.Text
  userId             String
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String                @unique
  clientSecret                     String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  public                           Boolean?
  type                             String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         Json?
  resources                        OauthClientResource[]
  refreshTokens                    OauthRefreshToken[]
  accessTokens                     OauthAccessToken[]
  consents                         OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String                @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      Json?
  clients                       OauthClientResource[]

  @@map("oauthResource")
}

model OauthClientResource {
  id         String        @id
  clientId   String
  client     OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId String
  resource   OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata   Json?
  createdAt  DateTime?

  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String             @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]
  accessTokens            OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?            @unique
  clientId                String
  client                  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  refreshToken            OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  client                  OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime?
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}

enum OrganizationRole {
  OWNER
  ADMIN
  TEACHER
}

enum OrganizationPermissionMode {
  SIMPLE
  ADVANCED
}

enum EnrollmentMode {
  OPEN
  INVITE_ONLY
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseProgressionMode {
  OPEN
  SEQUENTIAL
}

enum CohortStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CohortStaffRole {
  INSTRUCTOR
  ASSISTANT
}

enum CourseCollaboratorRole {
  EDITOR
}

enum ZoomConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

enum CohortMeetingStatus {
  SCHEDULED
  STARTED
  ENDED
  CANCELLED
}

enum CourseItemType {
  MATERIAL
  ASSESSMENT
  VOCABULARY_SET
}

enum RequirementPolicy {
  ALL
  ANY
}

enum MaterialRequirementType {
  ASSESSMENT
  VOCABULARY_SET
}

enum AssessmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AssessmentQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  WRITTEN
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  IN_REVIEW
  GRADED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnrollmentSource {
  OPEN
  INVITE
  PURCHASE
  MANUAL
  COHORT
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model Organization {
  id                     String                     @id @default(cuid())
  name                   String
  slug                   String                     @unique
  logoUrl                String?
  defaultEnrollmentMode  EnrollmentMode             @default(INVITE_ONLY)
  permissionMode         OrganizationPermissionMode @default(SIMPLE)
  teacherCanCreateCourse Boolean                    @default(true)
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  members                OrganizationMember[]
  invites                OrganizationInvite[]
  courses                Course[]
  materials              Material[]
  assessments            Assessment[]
  vocabularySets         VocabularySet[]
  zoomConnection         ZoomConnection?
  assets                 Asset[]
}

model OrganizationMember {
  id                        String               @id @default(cuid())
  organizationId            String
  userId                    String
  role                      OrganizationRole
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ownedCourses              Course[]             @relation("CourseOwner")
  courseCollaborations      CourseCollaborator[]
  cohortStaffMemberships    CohortStaff[]
  createdMaterials          Material[]           @relation("MaterialCreator")
  createdAssessments        Assessment[]         @relation("AssessmentCreator")
  createdVocabularySets     VocabularySet[]      @relation("VocabularySetCreator")
  createdEnrollmentInvites  EnrollmentInvite[]   @relation("EnrollmentInviteCreator")
  reviewedAssessmentAnswers AssessmentAnswer[]   @relation("AssessmentAnswerReviewer")
  connectedZoomAccounts     ZoomConnection[]     @relation("ZoomConnectionCreator")
  createdCohortMeetings     CohortMeeting[]      @relation("CohortMeetingCreator")
  sentOrganizationInvites   OrganizationInvite[] @relation("OrganizationInviteSender")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@index([userId])
}

model OrganizationInvite {
  id                    String             @id @default(cuid())
  organizationId        String
  email                 String
  role                  OrganizationRole
  tokenHash             String             @unique
  pendingKey            String?            @unique
  invitedByMembershipId String?
  acceptedByUserId      String?
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy             OrganizationMember? @relation("OrganizationInviteSender", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)
  acceptedBy            User?              @relation("OrganizationInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([email, acceptedAt, revokedAt])
}

model Course {
  id                String                @id @default(cuid())
  organizationId    String
  ownerMembershipId String
  title             String
  slug              String
  description       String?
  thumbnailUrl      String?
  price             Int                   @default(0)
  currency          String                @default("IDR")
  enrollmentMode    EnrollmentMode?
  status            CourseStatus          @default(DRAFT)
  progressionMode   CourseProgressionMode @default(OPEN)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             OrganizationMember    @relation("CourseOwner", fields: [ownerMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  modules           CourseModule[]
  collaborators     CourseCollaborator[]
  cohorts           Cohort[]
  enrollments       CourseEnrollment[]
  enrollmentInvites EnrollmentInvite[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([ownerMembershipId])
  @@index([organizationId, status])
}

model CourseCollaborator {
  id                   String                 @id @default(cuid())
  courseId             String
  organizationId       String
  organizationMemberId String
  role                 CourseCollaboratorRole @default(EDITOR)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  course               Course                 @relation(fields: [courseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember   OrganizationMember     @relation(fields: [organizationMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([courseId, organizationMemberId])
  @@index([organizationMemberId])
}

model Cohort {
  id                 String              @id @default(cuid())
  courseId           String
  organizationId     String
  name               String
  description        String?
  whatsappGroupUrl   String?
  status             CohortStatus        @default(DRAFT)
  enrollmentMode     EnrollmentMode?
  price              Int?
  capacity           Int?
  startsAt           DateTime?
  endsAt             DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  course             Course              @relation(fields: [courseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  staff              CohortStaff[]
  enrollments        CohortEnrollment[]
  enrollmentInvites  EnrollmentInvite[]
  meetings           CohortMeeting[]
  assessmentAttempts AssessmentAttempt[]

  @@unique([id, courseId])
  @@unique([id, organizationId])
  @@index([courseId, status])
}

model ZoomConnection {
  id                      String               @id @default(cuid())
  organizationId          String               @unique
  connectedByMembershipId String
  zoomAccountId           String
  zoomUserId              String
  encryptedAccessToken    String
  encryptedRefreshToken   String
  accessTokenExpiresAt    DateTime
  scope                   String?
  status                  ZoomConnectionStatus @default(CONNECTED)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  organization            Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy             OrganizationMember   @relation("ZoomConnectionCreator", fields: [connectedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([connectedByMembershipId])
  @@index([zoomAccountId])
}

model CohortMeeting {
  id                    String              @id @default(cuid())
  cohortId              String
  organizationId        String
  createdByMembershipId String
  title                 String
  agenda                String?
  zoomMeetingId         String?             @unique
  zoomMeetingUuid       String?
  joinUrl               String?
  startsAt              DateTime
  durationMinutes       Int
  timezone              String
  status                CohortMeetingStatus @default(SCHEDULED)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  cohort                Cohort              @relation(fields: [cohortId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy             OrganizationMember  @relation("CohortMeetingCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([cohortId, startsAt])
  @@index([createdByMembershipId])
  @@index([status, startsAt])
}

model CohortStaff {
  id                   String             @id @default(cuid())
  cohortId             String
  organizationId       String
  organizationMemberId String
  role                 CohortStaffRole
  createdAt            DateTime           @default(now())
  cohort               Cohort             @relation(fields: [cohortId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organizationMember   OrganizationMember @relation(fields: [organizationMemberId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([cohortId, organizationMemberId])
  @@index([organizationMemberId])
}

model CourseModule {
  id             String       @id @default(cuid())
  courseId       String
  organizationId String
  title          String
  description    String?
  position       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  course         Course       @relation(fields: [courseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  items          CourseItem[]

  @@unique([courseId, position])
  @@unique([id, organizationId])
  @@index([courseId])
}

model CourseItem {
  id              String              @id @default(cuid())
  moduleId        String
  organizationId  String
  type            CourseItemType
  position        Int
  materialId      String?
  assessmentId    String?
  vocabularySetId String?
  isPublished     Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  module          CourseModule        @relation(fields: [moduleId, organizationId], references: [id, organizationId], onDelete: Cascade)
  material        Material?           @relation(fields: [materialId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assessment      Assessment?         @relation(fields: [assessmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vocabularySet   VocabularySet?      @relation(fields: [vocabularySetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  progress        ContentProgress[]
  attempts        AssessmentAttempt[]

  @@unique([moduleId, position])
  @@unique([id, organizationId])
  @@index([materialId])
  @@index([assessmentId])
  @@index([vocabularySetId])
}

model Material {
  id                     String                @id @default(cuid())
  organizationId         String
  createdByMembershipId  String
  title                  String
  description            String?
  content                Json
  editorSchemaVersion    Int                   @default(1)
  requirementPolicy      RequirementPolicy     @default(ALL)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy              OrganizationMember    @relation("MaterialCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  courseItems            CourseItem[]
  completionRequirements MaterialRequirement[]
  assets                 MaterialAsset[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([createdByMembershipId])
}

model MaterialRequirement {
  id              String                  @id @default(cuid())
  materialId      String
  organizationId  String
  type            MaterialRequirementType
  assessmentId    String?
  vocabularySetId String?
  minimumScore    Int?
  position        Int
  material        Material                @relation(fields: [materialId, organizationId], references: [id, organizationId], onDelete: Cascade)
  assessment      Assessment?             @relation(fields: [assessmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vocabularySet   VocabularySet?          @relation(fields: [vocabularySetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([materialId, position])
  @@index([assessmentId])
  @@index([vocabularySetId])
}

model Assessment {
  id                    String                @id @default(cuid())
  organizationId        String
  createdByMembershipId String
  title                 String
  description           String?
  status                AssessmentStatus      @default(DRAFT)
  editorSchemaVersion   Int                   @default(1)
  instructions          Json?
  passingScore          Int?
  maxAttempts           Int?
  timeLimitMinutes      Int?
  shuffleQuestions      Boolean               @default(false)
  shuffleOptions        Boolean               @default(false)
  publishedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             OrganizationMember    @relation("AssessmentCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  questions             AssessmentQuestion[]
  courseItems           CourseItem[]
  attempts              AssessmentAttempt[]
  materialRequirements  MaterialRequirement[]

  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([createdByMembershipId])
}

model AssessmentQuestion {
  id           String                 @id @default(cuid())
  assessmentId String
  type         AssessmentQuestionType
  prompt       Json
  explanation  Json?
  points       Int                    @default(1)
  position     Int
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options      AssessmentOption[]
  answers      AssessmentAnswer[]

  @@unique([assessmentId, position])
  @@index([assessmentId])
}

model AssessmentOption {
  id         String                      @id @default(cuid())
  questionId String
  content    Json
  isCorrect  Boolean                     @default(false)
  position   Int
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt
  question   AssessmentQuestion          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selections AssessmentAnswerSelection[]

  @@unique([questionId, position])
  @@index([questionId])
}

model VocabularySet {
  id                    String                @id @default(cuid())
  organizationId        String
  createdByMembershipId String
  title                 String
  description           String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy             OrganizationMember    @relation("VocabularySetCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  entries               VocabularyEntry[]
  courseItems           CourseItem[]
  materialRequirements  MaterialRequirement[]

  @@unique([id, organizationId])
  @@index([organizationId])
  @@index([createdByMembershipId])
}

model VocabularyEntry {
  id              String        @id @default(cuid())
  vocabularySetId String
  organizationId  String
  term            String
  definition      String
  examples        Json          @default("[]")
  audioAssetId    String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  vocabularySet   VocabularySet @relation(fields: [vocabularySetId, organizationId], references: [id, organizationId], onDelete: Cascade)
  audioAsset      Asset?        @relation(fields: [audioAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([audioAssetId])
}

model CourseEnrollment {
  id          String           @id @default(cuid())
  courseId    String
  userId      String
  status      EnrollmentStatus @default(PENDING)
  source      EnrollmentSource
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  expiresAt   DateTime?
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId, status])
}

model CohortEnrollment {
  id          String           @id @default(cuid())
  cohortId    String
  userId      String
  status      EnrollmentStatus @default(PENDING)
  source      EnrollmentSource
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  cohort      Cohort           @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId, status])
}

model EnrollmentInvite {
  id                    String             @id @default(cuid())
  courseId              String
  organizationId        String
  cohortId              String?
  createdByMembershipId String
  token                 String             @unique
  expiresAt             DateTime?
  maxUses               Int?
  useCount              Int                @default(0)
  revokedAt             DateTime?
  createdAt             DateTime           @default(now())
  course                Course             @relation(fields: [courseId, organizationId], references: [id, organizationId], onDelete: Cascade)
  cohort                Cohort?            @relation(fields: [cohortId, courseId], references: [id, courseId], onDelete: Cascade)
  createdBy             OrganizationMember @relation("EnrollmentInviteCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([courseId])
  @@index([cohortId])
  @@index([createdByMembershipId])
}

model ContentProgress {
  id           String         @id @default(cuid())
  courseItemId String
  userId       String
  status       ProgressStatus @default(IN_PROGRESS)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?
  updatedAt    DateTime       @updatedAt
  courseItem   CourseItem     @relation(fields: [courseItemId], references: [id], onDelete: Restrict)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseItemId, userId])
  @@index([userId, status])
}

model AssessmentAttempt {
  id             String                  @id @default(cuid())
  assessmentId   String
  courseItemId   String
  organizationId String
  cohortId       String?
  userId         String
  attemptNumber  Int
  status         AssessmentAttemptStatus @default(IN_PROGRESS)
  score          Int?
  maxScore       Int?
  startedAt      DateTime                @default(now())
  submittedAt    DateTime?
  gradedAt       DateTime?
  assessment     Assessment              @relation(fields: [assessmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  courseItem     CourseItem              @relation(fields: [courseItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cohort         Cohort?                 @relation(fields: [cohortId], references: [id], onDelete: SetNull)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers        AssessmentAnswer[]

  @@unique([courseItemId, userId, attemptNumber])
  @@unique([id, organizationId])
  @@index([assessmentId])
  @@index([cohortId, status])
  @@index([userId, status])
}

model AssessmentAnswer {
  id                     String                      @id @default(cuid())
  attemptId              String
  organizationId         String
  questionId             String
  content                Json?
  autoScore              Int?
  manualScore            Int?
  feedback               Json?
  reviewedByMembershipId String?
  reviewedAt             DateTime?
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  attempt                AssessmentAttempt           @relation(fields: [attemptId, organizationId], references: [id, organizationId], onDelete: Cascade)
  question               AssessmentQuestion          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  reviewedBy             OrganizationMember?         @relation("AssessmentAnswerReviewer", fields: [reviewedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  selectedOptions        AssessmentAnswerSelection[]

  @@unique([attemptId, questionId])
  @@unique([id, organizationId])
  @@index([questionId])
  @@index([reviewedByMembershipId])
}

model AssessmentAnswerSelection {
  answerId String
  optionId String
  answer   AssessmentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option   AssessmentOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([answerId, optionId])
  @@index([optionId])
}

model Asset {
  id                String            @id @default(cuid())
  organizationId    String
  uploadedByUserId  String?
  objectKey         String            @unique
  fileName          String
  contentType       String
  size              Int
  etag              String?
  confirmedAt       DateTime?
  deletedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy        User?             @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  materials         MaterialAsset[]
  vocabularyEntries VocabularyEntry[]

  @@unique([id, organizationId])
  @@index([organizationId, deletedAt])
  @@index([uploadedByUserId, deletedAt])
}

model MaterialAsset {
  materialId     String
  assetId        String
  organizationId String
  material       Material @relation(fields: [materialId, organizationId], references: [id, organizationId], onDelete: Cascade)
  asset          Asset    @relation(fields: [assetId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@id([materialId, assetId])
  @@index([assetId])
}
